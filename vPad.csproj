<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>vPad</AssemblyName>
    <RootNamespace>vPad</RootNamespace>
    <StartupObject>vPad.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- made by running vPad.exe with make-icon (the drawing is src\Ui\Brand.cs), in vShell's default colours; the window's icon follows the theme -->
    <ApplicationIcon>vpad.ico</ApplicationIcon>
    <Version>0.1.6</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- the text editor (MIT): line numbers, syntax colours, folding-free and fast with big files -->
    <PackageReference Include="AvalonEdit" Version="6.3.0.90" />
    <!-- Markdown for the preview (BSD-2) -->
    <PackageReference Include="Markdig" Version="0.37.0" />
    <!-- files on servers (SFTP), with vTerm's saved connections -->
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- the syntax colour definitions, built into vPad.exe -->
    <EmbeddedResource Include="src\Syntax\*.xshd" LogicalName="vPad.Syntax.%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- the suite's shared library (git submodule vSuite.Core): theme, glass, styles, questions, log, updater, Options blocks -->
  <ItemGroup>
    <ProjectReference Include="vSuite.Core\vSuite.Core\vSuite.Core.csproj" />
    <Compile Remove="vSuite.Core\**" />
    <Page Remove="vSuite.Core\**" />
    <None Remove="vSuite.Core\**" />
    <EmbeddedResource Remove="vSuite.Core\**" />
    <Resource Remove="vSuite.Core\**" />
  </ItemGroup>

  <!-- the tests (tests\vPad.Tests) are their own project: dotnet test tests\vPad.Tests -->
  <ItemGroup>
    <Compile Remove="tests\**" />
    <Page Remove="tests\**" />
    <None Remove="tests\**" />
    <EmbeddedResource Remove="tests\**" />
  </ItemGroup>

</Project>