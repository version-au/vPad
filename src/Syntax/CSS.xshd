<?xml version="1.0"?>
<!-- vPad's colours for CSS - the names below are coloured from the vShell theme at run time (Syntax.cs) -->
<SyntaxDefinition name="CSS" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#7F849C" fontStyle="italic"/>
  <Color name="String" foreground="#A6E3A1"/>
  <Color name="Number" foreground="#FAB387"/>
  <Color name="Keyword" foreground="#89B4FA"/>
  <Color name="Key" foreground="#89B4FA"/>
  <Color name="Type" foreground="#F9E2AF"/>
  <Color name="Punct" foreground="#9399B2"/>
  <Color name="Variable" foreground="#F5C2E7"/>
  <Color name="Heading" foreground="#89B4FA" fontWeight="bold"/>
  <Color name="Bold" fontWeight="bold"/>
  <Color name="Italic" fontStyle="italic"/>
  <Color name="Code" foreground="#A6E3A1"/>
  <Color name="Link" foreground="#89B4FA"/>
  <Color name="Tag" foreground="#89B4FA"/>
  <Color name="Attr" foreground="#F5C2E7"/>
  <RuleSet ignoreCase="true">
    <Span color="Comment" multiline="true" begin="/\*" end="\*/" />
    <Span color="Comment" begin="//" />
    <Span color="String"><Begin>"</Begin><End>"</End></Span>
    <Span color="String"><Begin>'</Begin><End>'</End></Span>
    <Rule color="Keyword">@[\w\-]+|!important</Rule>
    <Rule color="Key">(?&lt;=^\s*|[\{;]\s*)-{0,2}[a-z][\w\-]*(?=\s*:(?!:))</Rule>
    <Rule color="Number">\#[0-9a-f]{3,8}\b(?=\s*[;,\)\s])|(?&lt;![\w\-])-?\d*\.?\d+(px|em|rem|%|vh|vw|vmin|vmax|s|ms|deg|fr|pt|ch)?\b</Rule>
    <Rule color="Attr">[\.\#][a-z_][\w\-]*|::?[a-z\-]+</Rule>
    <Rule color="Variable">--[\w\-]+|\$[\w\-]+</Rule>
    <Rule color="Punct">[\{\};:,]</Rule>
  </RuleSet>
</SyntaxDefinition>
