<?xml version="1.0"?>
<!-- vPad's colours for PowerShell - the names below are coloured from the vShell theme at run time (Syntax.cs) -->
<SyntaxDefinition name="PowerShell" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#7F849C" fontStyle="italic"/>
  <Color name="String" foreground="#A6E3A1"/>
  <Color name="Number" foreground="#FAB387"/>
  <Color name="Keyword" foreground="#89B4FA"/>
  <Color name="Key" foreground="#89B4FA"/>
  <Color name="Type" foreground="#F9E2AF"/>
  <Color name="Punct" foreground="#9399B2"/>
  <Color name="Variable" foreground="#F5C2E7"/>
  <Color name="Heading" foreground="#89B4FA" fontWeight="bold"/>
  <Color name="Bold" fontWeight="bold"/>
  <Color name="Italic" fontStyle="italic"/>
  <Color name="Code" foreground="#A6E3A1"/>
  <Color name="Link" foreground="#89B4FA"/>
  <Color name="Tag" foreground="#89B4FA"/>
  <Color name="Attr" foreground="#F5C2E7"/>
  <RuleSet ignoreCase="true">
    <Span color="Comment" multiline="true" begin="&lt;\#" end="\#&gt;" />
    <Span color="Comment" begin="\#" />
    <Span color="String" multiline="true"><Begin>@"</Begin><End>^"@</End><RuleSet><Rule color="Variable">\$\{[^\}]*\}|\$[\w:]+</Rule></RuleSet></Span>
    <Span color="String" multiline="true"><Begin>@'</Begin><End>^'@</End></Span>
    <Span color="String"><Begin>"</Begin><End>"</End>
      <RuleSet><Span begin="`" end="." /><Rule color="Variable">\$\{[^\}]*\}|\$[\w:]+</Rule></RuleSet></Span>
    <Span color="String"><Begin>'</Begin><End>'</End></Span>
    <Rule color="Variable">\$\{[^\}]*\}|\$[\w:\?\^]+</Rule>
    <Rule color="Type">\[[\w\.\[\],\s]+\](?!\s*=)</Rule>
    <Keywords color="Keyword">
      <Word>if</Word><Word>else</Word><Word>elseif</Word><Word>foreach</Word><Word>for</Word><Word>while</Word><Word>do</Word><Word>until</Word>
      <Word>switch</Word><Word>function</Word><Word>filter</Word><Word>param</Word><Word>return</Word><Word>try</Word><Word>catch</Word>
      <Word>finally</Word><Word>throw</Word><Word>trap</Word><Word>begin</Word><Word>process</Word><Word>end</Word><Word>in</Word>
      <Word>break</Word><Word>continue</Word><Word>exit</Word><Word>class</Word><Word>enum</Word><Word>using</Word>
    </Keywords>
    <Rule color="Attr">(?&lt;=\s)-[a-z][\w]*</Rule>
    <Rule color="Key">\b[a-z]+-[a-z]\w*\b</Rule>
    <Rule color="Number">\b\d+(\.\d+)?(kb|mb|gb|tb)?\b</Rule>
    <Rule color="Punct">[\|\{\}\(\);=]</Rule>
  </RuleSet>
</SyntaxDefinition>
