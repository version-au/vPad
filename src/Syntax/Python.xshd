<?xml version="1.0"?>
<!-- vPad's colours for Python - the names below are coloured from the vShell theme at run time (Syntax.cs) -->
<SyntaxDefinition name="Python" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#7F849C" fontStyle="italic"/>
  <Color name="String" foreground="#A6E3A1"/>
  <Color name="Number" foreground="#FAB387"/>
  <Color name="Keyword" foreground="#89B4FA"/>
  <Color name="Key" foreground="#89B4FA"/>
  <Color name="Type" foreground="#F9E2AF"/>
  <Color name="Punct" foreground="#9399B2"/>
  <Color name="Variable" foreground="#F5C2E7"/>
  <Color name="Heading" foreground="#89B4FA" fontWeight="bold"/>
  <Color name="Bold" fontWeight="bold"/>
  <Color name="Italic" fontStyle="italic"/>
  <Color name="Code" foreground="#A6E3A1"/>
  <Color name="Link" foreground="#89B4FA"/>
  <Color name="Tag" foreground="#89B4FA"/>
  <Color name="Attr" foreground="#F5C2E7"/>
  <RuleSet>
    <Span color="Comment" begin="\#" />
    <Span color="String" multiline="true"><Begin>[rRbBfFuU]{0,2}"""</Begin><End>"""</End></Span>
    <Span color="String" multiline="true"><Begin>[rRbBfFuU]{0,2}'''</Begin><End>'''</End></Span>
    <Span color="String"><Begin>[rRbBfFuU]{0,2}"</Begin><End>"</End><RuleSet><Span begin="\\" end="." /></RuleSet></Span>
    <Span color="String"><Begin>[rRbBfFuU]{0,2}'</Begin><End>'</End><RuleSet><Span begin="\\" end="." /></RuleSet></Span>
    <Rule color="Attr">^\s*@[\w\.]+</Rule>
    <Rule color="Type">(?&lt;=\b(def|class)\s+)\w+</Rule>
    <Keywords color="Keyword">
      <Word>def</Word><Word>class</Word><Word>return</Word><Word>if</Word><Word>elif</Word><Word>else</Word><Word>for</Word><Word>while</Word>
      <Word>in</Word><Word>not</Word><Word>and</Word><Word>or</Word><Word>is</Word><Word>import</Word><Word>from</Word><Word>as</Word>
      <Word>try</Word><Word>except</Word><Word>finally</Word><Word>raise</Word><Word>with</Word><Word>yield</Word><Word>lambda</Word>
      <Word>pass</Word><Word>break</Word><Word>continue</Word><Word>global</Word><Word>nonlocal</Word><Word>async</Word><Word>await</Word>
      <Word>del</Word><Word>assert</Word><Word>match</Word><Word>case</Word><Word>True</Word><Word>False</Word><Word>None</Word><Word>self</Word>
    </Keywords>
    <Rule color="Number">\b0[xX][0-9a-fA-F_]+\b|\b\d[\d_]*(\.\d+)?([eE][+\-]?\d+)?j?\b</Rule>
    <Rule color="Punct">[\(\)\[\]\{\}:,=]</Rule>
  </RuleSet>
</SyntaxDefinition>
