<?xml version="1.0"?>
<!-- vPad's colours for Batch - the names below are coloured from the vShell theme at run time (Syntax.cs) -->
<SyntaxDefinition name="Batch" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#7F849C" fontStyle="italic"/>
  <Color name="String" foreground="#A6E3A1"/>
  <Color name="Number" foreground="#FAB387"/>
  <Color name="Keyword" foreground="#89B4FA"/>
  <Color name="Key" foreground="#89B4FA"/>
  <Color name="Type" foreground="#F9E2AF"/>
  <Color name="Punct" foreground="#9399B2"/>
  <Color name="Variable" foreground="#F5C2E7"/>
  <Color name="Heading" foreground="#89B4FA" fontWeight="bold"/>
  <Color name="Bold" fontWeight="bold"/>
  <Color name="Italic" fontStyle="italic"/>
  <Color name="Code" foreground="#A6E3A1"/>
  <Color name="Link" foreground="#89B4FA"/>
  <Color name="Tag" foreground="#89B4FA"/>
  <Color name="Attr" foreground="#F5C2E7"/>
  <RuleSet ignoreCase="true">
    <Rule color="Comment">^\s*@?(rem(\s.*)?|::.*)$</Rule>
    <Rule color="Heading">^\s*:\w+</Rule>
    <Span color="String"><Begin>"</Begin><End>"</End><RuleSet><Rule color="Variable">%[\w~:\-=,\.]+%|%%?~?\w|!\w+!</Rule></RuleSet></Span>
    <Rule color="Variable">%[\w~:\-=,\.]+%|%%?~?\w|!\w+!</Rule>
    <Keywords color="Keyword">
      <Word>echo</Word><Word>set</Word><Word>if</Word><Word>else</Word><Word>goto</Word><Word>call</Word><Word>for</Word><Word>in</Word>
      <Word>do</Word><Word>exist</Word><Word>not</Word><Word>defined</Word><Word>errorlevel</Word><Word>exit</Word><Word>setlocal</Word>
      <Word>endlocal</Word><Word>pause</Word><Word>cd</Word><Word>shift</Word><Word>start</Word><Word>del</Word><Word>copy</Word><Word>mkdir</Word>
    </Keywords>
    <Rule color="Punct">[@\|&amp;&gt;&lt;\(\)]</Rule>
  </RuleSet>
</SyntaxDefinition>
