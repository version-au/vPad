<?xml version="1.0"?>
<!-- vPad's colours for Shell - the names below are coloured from the vShell theme at run time (Syntax.cs) -->
<SyntaxDefinition name="Shell" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">
  <Color name="Comment" foreground="#7F849C" fontStyle="italic"/>
  <Color name="String" foreground="#A6E3A1"/>
  <Color name="Number" foreground="#FAB387"/>
  <Color name="Keyword" foreground="#89B4FA"/>
  <Color name="Key" foreground="#89B4FA"/>
  <Color name="Type" foreground="#F9E2AF"/>
  <Color name="Punct" foreground="#9399B2"/>
  <Color name="Variable" foreground="#F5C2E7"/>
  <Color name="Heading" foreground="#89B4FA" fontWeight="bold"/>
  <Color name="Bold" fontWeight="bold"/>
  <Color name="Italic" fontStyle="italic"/>
  <Color name="Code" foreground="#A6E3A1"/>
  <Color name="Link" foreground="#89B4FA"/>
  <Color name="Tag" foreground="#89B4FA"/>
  <Color name="Attr" foreground="#F5C2E7"/>
  <RuleSet>
    <Span color="Comment" begin="(?&lt;=^|\s)#" />
    <Span color="String" multiline="true"><Begin>"</Begin><End>"</End>
      <RuleSet><Span begin="\\" end="." /><Rule color="Variable">\$\{[^\}]*\}|\$[\w@#\?\*!\-]+</Rule></RuleSet></Span>
    <Span color="String" multiline="true"><Begin>'</Begin><End>'</End></Span>
    <Rule color="Variable">\$\{[^\}]*\}|\$[\w@#\?\*!\-]+</Rule>
    <Keywords color="Keyword">
      <Word>if</Word><Word>then</Word><Word>else</Word><Word>elif</Word><Word>fi</Word><Word>for</Word><Word>while</Word><Word>until</Word>
      <Word>do</Word><Word>done</Word><Word>case</Word><Word>esac</Word><Word>in</Word><Word>function</Word><Word>return</Word><Word>export</Word>
      <Word>local</Word><Word>readonly</Word><Word>set</Word><Word>unset</Word><Word>source</Word><Word>exit</Word><Word>break</Word><Word>continue</Word>
      <Word>echo</Word><Word>printf</Word><Word>cd</Word><Word>sudo</Word><Word>shift</Word><Word>trap</Word><Word>eval</Word><Word>exec</Word>
    </Keywords>
    <Rule color="Number">(?&lt;![\w\.\-])\d+(?![\w\.])</Rule>
    <Rule color="Punct">[\|&amp;;&gt;&lt;\(\)\[\]\{\}]</Rule>
  </RuleSet>
</SyntaxDefinition>
